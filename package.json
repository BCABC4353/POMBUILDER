{
  "name": "pom-builder",
  "version": "1.0.11",
  "productName": "POM Builder",
  "description": "POM Builder — mail-ready PCS paperwork for HOLD - POM REQUIRED claims",
  "author": "BC-ABC",
  "main": "dist/main/main/index.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "npm run generate-config && concurrently \"npm run dev:main\" \"npm run dev:renderer\" \"npm run dev:electron\"",
    "dev:main": "tsc -p tsconfig.main.json --watch",
    "dev:renderer": "vite",
    "dev:electron": "wait-on tcp:5173 && electron .",
    "generate-config": "node scripts/generate-config.js",
    "build": "npm run generate-config && npm run build:main && npm run build:renderer",
    "build:main": "tsc -p tsconfig.main.json",
    "build:renderer": "vite build",
    "typecheck": "tsc --noEmit -p tsconfig.main.json && tsc --noEmit -p tsconfig.renderer.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src scripts/*.js *.config.js",
    "package:win": "npm run build && electron-builder --win --publish never",
    "dist": "npm run build && electron-builder --win --publish never"
  },
  "dependencies": {
    "@azure/msal-node": "^2.6.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.0",
    "electron-log": "^5.2.0",
    "electron-store": "^8.1.0",
    "electron-updater": "^6.8.9",
    "lucide-react": "^0.344.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tailwind-merge": "^2.2.0",
    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "@tailwindcss/container-queries": "^0.1.1",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.5.0",
    "@testing-library/react": "^16.0.0",
    "@types/node": "^20.11.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "@vitejs/plugin-react": "^4.2.0",
    "@vitest/coverage-v8": "^2.1.0",
    "autoprefixer": "^10.4.17",
    "concurrently": "^8.2.2",
    "electron": "^42.3.3",
    "electron-builder": "^26.15.2",
    "eslint": "^9.15.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "globals": "^15.13.0",
    "jsdom": "^25.0.0",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.3.0",
    "typescript-eslint": "^8.18.0",
    "vite": "^5.1.0",
    "vitest": "^2.1.0",
    "wait-on": "^7.2.0"
  }
}
